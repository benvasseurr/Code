# Webull credentials
WEBULL_EMAIL=your@email.com
WEBULL_PASSWORD=your_password
WEBULL_TRADING_PIN=your_6_digit_pin

# Set to true to simulate trades without spending real money
PAPER_TRADE=true

# Dollars to spend per congressional trade detected
TRADE_AMOUNT_USD=1000

# How often to poll for new disclosures (seconds). Min useful is ~60.
# Note: Congress has up to 45 days to disclose — "real time" means as soon as they file.
POLL_INTERVAL_SECONDS=300

# Optional: only mirror trades from specific members (comma-separated, case-insensitive partial match)
# Leave blank to follow ALL members of Congress
# Example: FILTER_MEMBERS=Pelosi,Tuberville,Ocasio-Cortez
FILTER_MEMBERS=

# SQLite database path for tracking already-processed disclosures
DB_PATH=trades.db
