# Solana RPC Configuration
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com

# Bot Wallet (base58-encoded private key)
PRIVATE_KEY=your_base58_private_key_here

# Sniping Configuration
BUY_AMOUNT_SOL=0.1
SLIPPAGE_BPS=500
# Priority fee in microlamports (increase for faster execution)
PRIORITY_FEE_MICROLAMPORTS=100000

# Dev Scoring Filters
# Minimum score (0-100) for a dev to be auto-sniped
MIN_DEV_SCORE=50
# Maximum number of token mints to track per dev
MAX_TOKENS_TO_TRACK=20

# Logging
LOG_LEVEL=info
LOG_FILE=logs/sniper.log

# Data storage path
DATA_DIR=./data

# Jupiter API
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Optional: Telegram notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
